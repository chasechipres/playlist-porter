{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(gh pr create*)",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/require-readme-update.sh\"",
            "timeout": 30,
            "statusMessage": "Checking README.md was updated"
          }
        ]
      }
    ]
  }
}
